generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid(7)) @db.Uuid
  name              String
  email             String?          @unique
  phone             String?          @unique
  /// Set when the phone was confirmed with an SMS code at registration. Null for early-access accounts.
  phoneVerifiedAt   DateTime?
  /// Internal ProfitHishab staff: may use /admin. Set only with `npm run admin:grant`, never through the API.
  isPlatformAdmin   Boolean          @default(false)
  passwordHash      String
  locale            String           @default("bn")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  memberships       BusinessMember[]
  passwordResets    PasswordReset[]
  adminActions      AdminAction[]
  paymentsSubmitted Payment[]        @relation("PaymentSubmittedBy")
  paymentsReviewed  Payment[]        @relation("PaymentReviewedBy")

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Business {
  id                   String            @id @default(uuid(7)) @db.Uuid
  ownerId              String            @db.Uuid
  name                 String
  logoUrl              String?
  phone                String?
  address              String?
  city                 String?
  businessType         String?
  facebookPageUrl      String?
  currency             String            @default("BDT")
  timezone             String            @default("Asia/Dhaka")
  defaultCourierId     String?           @db.Uuid
  defaultCourierCost   Int               @default(0)
  defaultReturnCost    Int               @default(0)
  defaultPackagingCost Int               @default(0)
  nextOrderNo          Int               @default(1001)
  /// End of the free trial; writes are refused after it. Null = no limit (early-access sellers).
  trialEndsAt          DateTime?
  /// Blocked by a platform admin: nobody in the business can log in. Null = not blocked.
  blockedAt            DateTime?
  blockedReason        String?
  /// When a payment was first confirmed; paying sellers are not told their "free trial" is ending.
  firstPaidAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  members              BusinessMember[]
  categories           Category[]
  products             Product[]
  customers            Customer[]
  couriers             Courier[]
  orders               Order[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  imports              Import[]
  importMappings       ImportMapping[]
  trialClaims          TrialClaim[]
  adminActions         AdminAction[]
  payments             Payment[]

  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  role       String   @default("owner")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_members")
}

model Category {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id           String         @id @default(uuid(7)) @db.Uuid
  businessId   String         @db.Uuid
  categoryId   String?        @db.Uuid
  name         String
  sku          String
  sellingPrice Int
  costPrice    Int
  stock        Int            @default(0)
  status       String         @default("active")
  importId     String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  prices       ProductPrice[]

  @@unique([businessId, sku])
  @@map("products")
}

/// Price history: one row per day the selling price or cost changed. An order takes
/// the row in effect on its orderDate, so later changes never rewrite past profit.
model ProductPrice {
  id            String   @id @default(uuid(7)) @db.Uuid
  businessId    String   @db.Uuid
  productId     String   @db.Uuid
  sellingPrice  Int
  costPrice     Int
  /// First day (business timezone) this price applies; it lasts until the next row.
  effectiveFrom DateTime @db.Date
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, effectiveFrom])
  @@map("product_prices")
}

model Customer {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String
  address    String?
  city       String?
  note       String?
  importId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([businessId, phone])
  @@map("customers")
}

model Courier {
  id                String   @id @default(uuid(7)) @db.Uuid
  businessId        String   @db.Uuid
  name              String
  defaultCost       Int      @default(0)
  defaultReturnCost Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders            Order[]

  @@map("couriers")
}

model Order {
  id              String               @id @default(uuid(7)) @db.Uuid
  businessId      String               @db.Uuid
  orderNo         Int
  customerId      String               @db.Uuid
  courierId       String?              @db.Uuid
  status          String               @default("new")
  paymentMethod   String               @default("cod")
  orderDate       DateTime             @db.Date
  deliveryAddress String?
  subtotal        Int
  discount        Int                  @default(0)
  deliveryCharge  Int                  @default(0)
  total           Int
  /// Cache of Σ quantity × unitCost over items; kept in sync in the same transaction.
  productCost     Int                  @default(0)
  courierCost     Int                  @default(0)
  packagingCost   Int                  @default(0)
  returnCost      Int                  @default(0)
  note            String?
  source          String               @default("manual")
  importId        String?              @db.Uuid
  externalRef     String?
  dedupeHash      String?
  /// Client-supplied Idempotency-Key for POST /orders; a retry with the same key returns this order.
  idempotencyKey  String?
  /// sha256 of the request body that created the order, to refuse a key reused with a different body.
  idempotencyHash String?
  deliveredAt     DateTime?
  returnedAt      DateTime?
  createdById     String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  courier         Courier?             @relation(fields: [courierId], references: [id], onDelete: SetNull)
  import          Import?              @relation(fields: [importId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  history         OrderStatusHistory[]

  @@unique([businessId, orderNo])
  @@unique([businessId, externalRef])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, orderDate, status])
  @@index([businessId, customerId])
  @@index([businessId, dedupeHash])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  orderId     String  @db.Uuid
  businessId  String  @db.Uuid
  productId   String  @db.Uuid
  productName String
  sku         String
  quantity    Int
  unitPrice   Int
  unitCost    Int
  lineTotal   Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([businessId, productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @db.Uuid
  businessId  String   @db.Uuid
  fromStatus  String?
  toStatus    String
  changedById String?  @db.Uuid
  changedAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model ExpenseCategory {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @db.Uuid
  name       String
  kind       String    @default("other")
  isSystem   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@unique([businessId, name])
  @@map("expense_categories")
}

model Expense {
  id          String          @id @default(uuid(7)) @db.Uuid
  businessId  String          @db.Uuid
  categoryId  String          @db.Uuid
  amount      Int
  expenseDate DateTime        @db.Date
  note        String?
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([businessId, expenseDate])
  @@map("expenses")
}

model Import {
  id            String      @id @default(uuid(7)) @db.Uuid
  businessId    String      @db.Uuid
  type          String      @default("orders")
  fileName      String
  status        String      @default("uploaded")
  mapping       Json?
  statusMapping Json?
  headers       Json        @default("[]")
  headersKey    String?
  totalRows     Int         @default(0)
  validRows     Int         @default(0)
  duplicateRows Int         @default(0)
  invalidRows   Int         @default(0)
  importedRows  Int         @default(0)
  createdById   String?     @db.Uuid
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows          ImportRow[]
  orders        Order[]

  @@index([businessId, createdAt])
  @@map("imports")
}

model ImportRow {
  id         String  @id @default(uuid(7)) @db.Uuid
  importId   String  @db.Uuid
  businessId String  @db.Uuid
  rowNumber  Int
  raw        Json
  normalized Json?
  status     String
  errors     Json?
  orderId    String? @db.Uuid
  groupKey   String?
  import     Import  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

/// The column mapping a seller last used for a given set of file headers, offered again next time.
model ImportMapping {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @db.Uuid
  headersKey String
  mapping    Json
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, headersKey])
  @@map("import_mappings")
}

/// One-time SMS codes that prove a seller owns a phone number before registering.
model PhoneOtp {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("phone_otps")
}

/// A verified phone number that has used its free trial. Kept when the business is deleted,
/// so deleting an account and registering again never starts a second trial.
model TrialClaim {
  phone      String    @id
  businessId String?   @db.Uuid
  claimedAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@map("trial_claims")
}

/// Forgot-password links (FR-AUTH-06): single use, 60 minutes, only a hash of the token is stored.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

/// What platform admins changed, newest first in the admin panel. Kept when the admin or business is deleted.
model AdminAction {
  id          String    @id @default(uuid(7)) @db.Uuid
  adminUserId String?   @db.Uuid
  businessId  String?   @db.Uuid
  /// set_access | block | unblock | reset_link | confirm_payment | reject_payment (CHECK constraint, ADMIN_ACTIONS in shared enums)
  action      String
  /// What changed, e.g. {"from": "...", "to": "..."} or {"reason": "..."}
  details     Json      @default("{}")
  createdAt   DateTime  @default(now())
  admin       User?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  business    Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("admin_actions")
}

/// A seller's manual bKash/Nagad payment for more access, checked by a platform admin.
/// CHECKs and two partial unique indexes are in the migration SQL (Prisma cannot express a partial index):
/// "payments_one_pending_per_business" (one pending per business) and "payments_method_transactionId_active_key"
/// (a TrxID is unique per method among pending and confirmed payments; a rejected payment releases it).
model Payment {
  id            String    @id @default(uuid(7)) @db.Uuid
  businessId    String    @db.Uuid
  submittedById String?   @db.Uuid
  /// bkash | nagad (CHECK, BILLING_METHODS in shared enums)
  method        String
  senderNumber  String
  /// Uppercase TrxID from the SMS; unique per method among pending and confirmed payments of every business.
  transactionId String
  /// 1 | 3 | 6 | 12 (CHECK)
  months        Int
  /// Poisha, price x months at submit time. > 0 (CHECK)
  amount        Int
  /// pending | confirmed | rejected (CHECK, BILLING_PAYMENT_STATUSES in shared enums)
  status        String    @default("pending")
  rejectReason  String?
  reviewedById  String?   @db.Uuid
  reviewedAt    DateTime?
  periodFrom    DateTime?
  periodTo      DateTime?
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submittedBy   User?     @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy    User?     @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("payments")
}
