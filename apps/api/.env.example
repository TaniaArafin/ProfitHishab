NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL="postgresql://profithishab:profithishab@localhost:5434/profithishab?schema=public"
PORT=4000
# Origin of the web app; the browser only ever talks to it (Next.js proxies /api to this server).
WEB_ORIGIN="http://localhost:3000"
# Set to true behind HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=300
REGISTER_LIMIT_PER_15_MINUTES=10
PASSWORD_RESET_LIMIT_PER_15_MINUTES=10
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
# Product search (docker compose service "search"). SEARCH_DRIVER=postgres searches without it.
# 127.0.0.1, not localhost: Node tries IPv6 first and Docker may only forward IPv4.
SEARCH_DRIVER=typesense
TYPESENSE_URL="http://127.0.0.1:8109"
TYPESENSE_API_KEY="profithishab-dev-key"
# false (test phase): sign up with email or phone + password, no SMS. true: the phone is confirmed
# with an SMS code. New businesses get the 7-day trial either way.
OTP_REQUIRED=false
# Registration codes (only used when OTP_REQUIRED=true). "log" writes each code to this terminal instead of sending an SMS (no gateway yet).
# OTP_FIXED_CODE makes every code this value (dev and e2e tests). With OTP_REQUIRED=true, production refuses both.
SMS_DRIVER=log
OTP_FIXED_CODE=123456
# Email (forgot-password links). "log" writes each email to this terminal; production needs "smtp".
# Any SMTP service works, e.g. Brevo or Resend (both have free tiers). Port 465 needs SMTP_SECURE=true.
MAIL_DRIVER=log
MAIL_FROM="ProfitHishab <no-reply@example.com>"
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
